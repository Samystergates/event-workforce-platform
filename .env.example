# Reference template for local development. The applications do not automatically
# load this root file; use the app-specific examples and inject values per process.
# Never put real credentials or production URLs in a committed environment file.

# Shared infrastructure
EUREKA_SERVER_URL=http://localhost:8761/eureka/
JWT_SECURITY_ENABLED=true
JWT_AUDIENCE=
JWT_SIGNING_SECRET=
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_RPM=600
GATEWAY_RATE_LIMIT_TRUSTED_PROXIES=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OUTBOX_TOPIC=eventico.outbox.events
OUTBOX_DLQ_TOPIC=eventico.outbox.events.dlq
OUTBOX_PUBLISH_DELAY_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_RETRY_SECONDS=10
REDIS_HOST=localhost
REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=
SHOW_SQL=false
LIBREOFFICE_HOME=
TESSDATA_PREFIX=

# Core / eventico runtime
EVENTICO_DB_URL=jdbc:mysql://localhost:3306/eventico-core-demo
EVENTICO_DB_USER=root
EVENTICO_DB_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ALERT_RECIPIENT=
TWILIO_ENABLED=false
FORM_CLIENT_URI=http://localhost:3000/review/client/
FORM_SP_URI=http://localhost:3001/review/service-provider/
EVENTICO_PUBLIC_BASE_URL=http://localhost:3000
EVENTICO_CONTACT_EMAIL=contact@example.test
INVOICE_COMPANY_NAME=Eventico Demo
INVOICE_COMPANY_ADDRESS=123 Demo Street
INVOICE_COMPANY_LOCATION=Demo City
INVOICE_COMPANY_PHONE=+1 555 0100
INVOICE_COMPANY_EMAIL=contact@example.test
INVOICE_COMPANY_WEBSITE=example.test
INVOICE_COMPANY_IBAN=DEMO-IBAN
INVOICE_COMPANY_VAT_NUMBER=DEMO-VAT
INVOICE_COMPANY_REGISTRATION_NUMBER=DEMO-REGISTRATION
INVOICE_SUBMISSION_EMAIL=invoices@example.test
INVOICE_RECIPIENT_DETAILS=Portfolio Demo Company | Demo registration, tax, and bank details
FORM_CORS_ALLOWED_ORIGINS=http://localhost:3001
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_MAILBOX=

# Form service
FORM_DB_URL=jdbc:mysql://localhost:3306/eventico-form
FORM_DB_USER=root
FORM_DB_PASSWORD=

# Timeclock service
TIMECLOCK_DB_URL=jdbc:mysql://localhost:3306/eventico-timeclock
TIMECLOCK_DB_USER=
TIMECLOCK_DB_PASSWORD=

# Finance service
FINANCE_DB_URL=jdbc:mysql://localhost:3306/eventico-finance
FINANCE_DB_USER=root
FINANCE_DB_PASSWORD=
FINANCE_CORS_ALLOWED_ORIGINS=http://localhost:3000
MSGRAPH_ENABLED=false
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=
PRIMARY_EMAIL_ADDRESS=invoices@example.test
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_CREDENTIALS_PATH=
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_PROCESSOR_LOCATION=eu
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_PROCESSOR_TYPE=Invoice Parser
DOCUMENT_AI_PROCESSOR_DISPLAY_NAME=Invoice Parser
FLYWAY_ENABLED=false

# Frontend apps
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:8060/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8060/api
